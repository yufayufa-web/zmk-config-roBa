#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };
    };

    macros {
        N00: N00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;
            label = "N00";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W             &kp E         &kp R                 &kp T                                          &kp Y        &kp U  &lt 5 I    &kp O    &kp P
&kp A      &kp S             &kp D         &kp F                 &kp G        &kp LS(LG(S))      &kp QUESTION   &kp H        &kp J  &kp K      &kp L    &kp ENTER
&kp Z      &kp X             &kp C         &kp V                 &kp B        &kp DELETE         &kp SLASH      &kp N        &kp M  &kp COMMA  &kp DOT  &kp RIGHT_SHIFT
&kp LCTRL  &mt LEFT_WIN TAB  &kp LEFT_ALT  &mt LEFT_SHIFT MINUS  &lt 3 LANG1  &lt 2 LANG2        &kp BACKSPACE  &lt 1 SPACE                             &tog 1
            >;

            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
        };

        NUM {
            bindings = <
&kp PERCENT  &kp N7  &kp N8  &kp N9  &kp F17                                 &kp AT_SIGN    &kp ASTERISK  &kp LPAR       &kp RIGHT_BRACE  &kp PIPE
&kp F15      &kp N4  &kp N5  &kp N6  &kp F21    &trans      &kp EXCLAMATION  &kp SQT        &kp RBKT      &kp BACKSLASH  &kp LBKT         &trans
&kp PERIOD   &kp N1  &kp N2  &kp N3  &kp COLON  &trans      &kp F14          &kp SEMICOLON  &kp LT        &kp GT         &kp F13          &trans
&trans       &kp N0  &N00    &trans  &trans     &trans      &trans           &trans                                                       &bt BT_CLR
            >;
        };

        FUNCTION {
            bindings = <
&kp PERCENT  &trans  &kp K_MUTE  &kp C_VOL_DN  &kp C_VOL_UP                               &kp F1   &kp F2   &kp F3   &kp F4   &kp F5
&kp F15      &trans  &trans      &kp C_BRI_DN  &kp C_BRI_UP  &trans      &kp EXCLAMATION  &kp F6   &kp F7   &kp F8   &kp F9   &trans
&trans       &trans  &trans      &trans        &trans        &trans      &kp F14          &kp F10  &kp F11  &kp F12  &kp F13  &trans
&trans       &trans  &trans      &trans        &trans        &trans      &trans           &trans                              &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                                &kp EQUAL  &kp HASH  &kp F16        &kp F19  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &kp EXCLAMATION  &trans     &kp AMPS  &kp AMPERSAND  &trans   &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &kp F14          &trans     &trans    &trans         &trans   &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans           &trans                                       &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
